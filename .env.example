# Indirizzo del Worker squadify-api (cartella worker/), es. https://squadify-api.TUONOME.workers.dev
# Se manca, l'app usa un catalogo di prova con soli nomi.
VITE_SQUADIFY_API=

# Facoltativo: Client ID dell'app Spotify, per il login "usa i tuoi ascolti" (solo utenti in allowlist).
# Copia questo file in .env (nella root) e inserisci il tuo valore.
VITE_SPOTIFY_CLIENT_ID=

# Facoltativo: indirizzo pubblico delle app. Se c'è, la CTA sulle card lo mostra al posto di "link in bio".
VITE_SHARE_URL=
